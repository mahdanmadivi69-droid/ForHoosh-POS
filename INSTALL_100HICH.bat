@echo off
chcp 65001 > nul
title 📦 پکیج نصب و آماده‌سازی سیستم ۱۰۰ هیچ
color 0B

echo ============================================================
echo   📦 راه‌اندازی و نصب اولیه CAFE OS برای کافه ۱۰۰ هیچ
echo ============================================================
echo.

where node >nul 2>nul
if %errorlevel% neq 0 (
    echo [خطا] Node.js یافت نشد. لطفاً ابتدا Node.js را نصب نمایید.
    pause
    exit /b 1
)

echo [۱] نصب و همگام‌سازی کتابخانه‌ها (Dependencies)...
call npm install --omit=dev --no-audit

echo.
echo [۲] کامپایل و ساخت پکیج نهایی پروداکشن (Vite + PWA)...
call npm run build

echo.
echo [۳] اجرای آزمون‌های راستی‌آزمایی ریاضیات مالی...
call npm test

echo.
echo ============================================================
echo ✅ نصب و اعتبارسنجی با موفقیت کامل انجام شد!
echo اکنون می‌توانید با دابل‌کلیک روی فایل RUN_100HICH.bat
echo برنامه را روی سیستم صندوق کافه ۱۰۰ هیچ اجرا کنید.
echo ============================================================
echo.
pause
